{
  "name": "WP-S controller",
  "tuning": {
    "reticle": false,
    "right_stick_zoom": false
  },
  "bindings": [
    {
      "input": {
        "button": "a"
      },
      "gesture": "tap",
      "action": {
        "type": "select"
      }
    },
    {
      "input": {
        "button": "a"
      },
      "gesture": "second_tap",
      "action": {
        "type": "select_same_type",
        "scope": "on_screen"
      }
    },
    {
      "input": {
        "button": "a"
      },
      "gesture": "hold",
      "action": {
        "type": "brush"
      }
    },
    {
      "input": {
        "button": "x"
      },
      "gesture": "press",
      "action": {
        "type": "context"
      }
    },
    {
      "input": {
        "button": "x"
      },
      "with": {
        "button": "rb"
      },
      "gesture": "press",
      "action": {
        "type": "context",
        "append": true
      }
    },
    {
      "input": {
        "button": "y"
      },
      "gesture": "tap",
      "action": {
        "type": "select_all",
        "scope": "on_screen"
      }
    },
    {
      "input": {
        "button": "y"
      },
      "gesture": "second_tap",
      "action": {
        "type": "select_all",
        "scope": "map"
      }
    },
    {
      "input": {
        "button": "l3"
      },
      "gesture": "tap",
      "action": {
        "type": "select_same_type",
        "scope": "map"
      }
    },
    {
      "input": {
        "button": "b"
      },
      "gesture": "press",
      "action": {
        "type": "cancel"
      }
    },
    {
      "input": {
        "button": "lt"
      },
      "gesture": "press",
      "action": {
        "type": "command_wheel"
      }
    },
    {
      "input": {
        "button": "lb"
      },
      "gesture": "press",
      "action": {
        "type": "build_wheel"
      }
    },
    {
      "input": {
        "button": "rt"
      },
      "gesture": "press",
      "action": {
        "type": "precision"
      }
    },
    {
      "input": {
        "button": "rb"
      },
      "gesture": "press",
      "action": {
        "type": "zoom_modifier"
      }
    },
    {
      "input": {
        "button": "r3"
      },
      "gesture": "tap",
      "action": {
        "type": "center_on_monarch"
      }
    },
    {
      "input": {
        "button": "r3"
      },
      "gesture": "hold",
      "action": {
        "type": "follow_selection"
      }
    },
    {
      "input": {
        "button": "view"
      },
      "gesture": "tap",
      "action": {
        "type": "jump_to_alert"
      }
    },
    {
      "input": {
        "button": "view"
      },
      "gesture": "hold",
      "action": {
        "type": "cycle_idle_builder"
      }
    },
    {
      "input": {
        "button": "menu"
      },
      "gesture": "press",
      "action": {
        "type": "toggle_overlay"
      }
    },
    {
      "input": {
        "button": "dpad_up"
      },
      "gesture": "press",
      "action": {
        "type": "recall_group",
        "group": 1
      }
    },
    {
      "input": {
        "button": "dpad_up"
      },
      "with": {
        "button": "rb"
      },
      "gesture": "press",
      "action": {
        "type": "assign_group",
        "group": 1
      }
    },
    {
      "input": {
        "button": "dpad_right"
      },
      "gesture": "press",
      "action": {
        "type": "recall_group",
        "group": 2
      }
    },
    {
      "input": {
        "button": "dpad_right"
      },
      "with": {
        "button": "rb"
      },
      "gesture": "press",
      "action": {
        "type": "assign_group",
        "group": 2
      }
    },
    {
      "input": {
        "button": "dpad_down"
      },
      "gesture": "press",
      "action": {
        "type": "recall_group",
        "group": 3
      }
    },
    {
      "input": {
        "button": "dpad_down"
      },
      "with": {
        "button": "rb"
      },
      "gesture": "press",
      "action": {
        "type": "assign_group",
        "group": 3
      }
    },
    {
      "input": {
        "button": "dpad_left"
      },
      "gesture": "press",
      "action": {
        "type": "recall_group",
        "group": 4
      }
    },
    {
      "input": {
        "button": "dpad_left"
      },
      "with": {
        "button": "rb"
      },
      "gesture": "press",
      "action": {
        "type": "assign_group",
        "group": 4
      }
    }
  ],
  "command_wheel": [
    {
      "type": "stop"
    },
    {
      "type": "patrol_mode"
    },
    {
      "type": "guard_mode"
    },
    {
      "type": "set_fire_state",
      "state": "hold_fire"
    },
    {
      "type": "set_fire_state",
      "state": "return_fire"
    },
    {
      "type": "set_fire_state",
      "state": "fire_at_will"
    },
    {
      "type": "cast_spell_mode"
    },
    {
      "type": "cycle_idle_builder"
    }
  ]
}
