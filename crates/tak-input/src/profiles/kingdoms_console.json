{
  "name": "Kingdoms Console",
  "fixed_slots": true,
  "bindings": [
    {"input": {"button": "a"}, "gesture": "tap", "action": {"type": "select"}},
    {"input": {"button": "a"}, "gesture": "second_tap", "action": {"type": "select_same_type", "scope": "on_screen"}},
    {"input": {"button": "a"}, "gesture": "hold", "action": {"type": "brush"}},
    {"input": {"button": "x"}, "gesture": "tap", "action": {"type": "context"}},
    {"input": {"button": "x"}, "gesture": "hold", "action": {"type": "attack_move"}},
    {"input": {"button": "y"}, "gesture": "tap", "action": {"type": "cast_spell_mode"}},
    {"input": {"button": "y"}, "gesture": "hold", "action": {"type": "spell_wheel"}},
    {"input": {"button": "b"}, "gesture": "tap", "action": {"type": "cancel"}},
    {"input": {"button": "b"}, "gesture": "hold", "action": {"type": "stop"}},
    {"input": {"button": "rb"}, "gesture": "press", "action": {"type": "queue_modifier"}},
    {"input": {"button": "rb"}, "gesture": "tap", "action": {"type": "select_all", "scope": "on_screen"}},
    {"input": {"button": "rb"}, "gesture": "second_tap", "action": {"type": "select_all", "scope": "map"}},
    {"input": {"button": "lb"}, "gesture": "tap", "action": {"type": "cycle_idle_builder"}},
    {"input": {"button": "lb"}, "gesture": "hold", "action": {"type": "build_wheel"}},
    {"input": {"button": "lt"}, "gesture": "press", "action": {"type": "command_wheel"}},
    {"input": {"button": "rt"}, "gesture": "tap", "action": {"type": "sub_select_cycle"}},
    {"input": {"button": "rt"}, "gesture": "hold", "action": {"type": "precision"}},
    {"input": {"button": "dpad_up"}, "gesture": "tap", "action": {"type": "recall_group", "group": 1}},
    {"input": {"button": "dpad_up"}, "gesture": "second_tap", "action": {"type": "jump_to_group", "group": 1}},
    {"input": {"button": "dpad_up"}, "gesture": "hold", "action": {"type": "assign_group", "group": 1}},
    {"input": {"button": "dpad_right"}, "gesture": "tap", "action": {"type": "recall_group", "group": 2}},
    {"input": {"button": "dpad_right"}, "gesture": "second_tap", "action": {"type": "jump_to_group", "group": 2}},
    {"input": {"button": "dpad_right"}, "gesture": "hold", "action": {"type": "assign_group", "group": 2}},
    {"input": {"button": "dpad_down"}, "gesture": "tap", "action": {"type": "recall_group", "group": 3}},
    {"input": {"button": "dpad_down"}, "gesture": "second_tap", "action": {"type": "jump_to_group", "group": 3}},
    {"input": {"button": "dpad_down"}, "gesture": "hold", "action": {"type": "assign_group", "group": 3}},
    {"input": {"button": "dpad_left"}, "gesture": "tap", "action": {"type": "recall_group", "group": 4}},
    {"input": {"button": "dpad_left"}, "gesture": "second_tap", "action": {"type": "jump_to_group", "group": 4}},
    {"input": {"button": "dpad_left"}, "gesture": "hold", "action": {"type": "assign_group", "group": 4}},
    {"input": {"button": "view"}, "gesture": "tap", "action": {"type": "jump_to_alert"}},
    {"input": {"button": "view"}, "gesture": "hold", "action": {"type": "crystal_ball"}},
    {"input": {"button": "menu"}, "gesture": "press", "action": {"type": "toggle_overlay"}},
    {"input": {"button": "l3"}, "gesture": "tap", "action": {"type": "center_on_monarch"}},
    {"input": {"button": "l3"}, "gesture": "second_tap", "action": {"type": "select_monarch"}},
    {"input": {"button": "l3"}, "gesture": "hold", "action": {"type": "select_monarch", "track": true}},
    {"input": {"button": "r3"}, "gesture": "tap", "action": {"type": "reset_zoom"}},
    {"input": {"button": "r3"}, "gesture": "hold", "action": {"type": "follow_selection"}}
  ],
  "command_wheel": [
    {"type": "stop"},
    {"type": "attack_mode"},
    {"type": "move_mode"},
    {"type": "open_ring", "ring": "stance"},
    {"type": "open_ring", "ring": "unit"},
    {"type": "guard_mode"},
    {"type": "patrol_mode"},
    {"type": "clear_mode"}
  ],
  "idle_wheel": [
    {"type": "recall_group", "group": 5},
    {"type": "recall_group", "group": 6},
    {"type": "recall_group", "group": 7},
    {"type": "recall_group", "group": 8},
    {"type": "recall_group", "group": 9},
    {"type": "center_on_monarch"},
    {"type": "cycle_idle_builder"},
    {"type": "select_all", "scope": "map"}
  ]
}
